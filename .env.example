# Rayfin local dev environment variables
# These are written automatically by `rayfin dev` / `rayfin up`
# Do NOT commit the real .env.fabric-* files

# Local development defaults (overridden by rayfin dev)
VITE_RAYFIN_API_URL=http://localhost:5168
VITE_RAYFIN_PUBLISHABLE_KEY=

# Set by `rayfin up` for Fabric deployment
# VITE_FABRIC_WORKSPACE_ID=
# VITE_FABRIC_ITEM_ID=
# VITE_FABRIC_PORTAL_URL=https://app.fabric.microsoft.com
